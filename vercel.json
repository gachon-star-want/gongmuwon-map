{
  "buildCommand": "npm run build",
  "devCommand": "npm --workspace apps/web run dev -- --host 0.0.0.0 --port $PORT",
  "installCommand": "npm install",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "builds": [
    {
      "src": "api/[...path].ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "npm run build",
        "distDir": "apps/web/dist"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' https://dapi.kakao.com https://t1.daumcdn.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.kakao.com https://*.kakao.co.kr https://*.kakaocdn.net https://*.daum.net https://*.daumcdn.net; font-src 'self' data:; connect-src 'self' https://*.kakao.com https://*.kakao.co.kr https://*.daum.net https://*.daumcdn.net; frame-src 'self' https://*.kakao.com https://*.daum.net; frame-ancestors 'none'; form-action 'self'; manifest-src 'self'; media-src 'self'; worker-src 'self' blob:"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), autoplay=(), camera=(), clipboard-read=(), clipboard-write=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), web-share=(), xr-spatial-tracking=()"
        }
      ]
    },
    {
      "source": "/api/v1/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/recompute-grades",
      "schedule": "30 18 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/[...path].ts?path=sitemap"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/index.html"
    },
    {
      "source": "/legal",
      "destination": "/index.html"
    },
    {
      "source": "/community",
      "destination": "/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path].ts?path=$1"
    },
    {
      "source": "/api",
      "destination": "/index.html"
    },
    {
      "source": "/r/(.*)",
      "destination": "/index.html"
    }
  ]
}
